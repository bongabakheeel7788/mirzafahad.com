{%- if key == "home" or key == "contact" -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": ["LegalService", "Attorney"],
  "name": "{{ site.name }}, {{ site.title }}",
  "url": "{{ site.url }}",
  "telephone": "{{ site.phoneRaw }}",
  "email": "{{ site.email }}",
  "image": "{{ site.url }}{{ site.photo }}",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "{{ site.address.line1 }}",
    "addressLocality": "Tandlianwala",
    "addressRegion": "{{ site.address.region }}",
    "addressCountry": "PK"
  },
  "areaServed": ["Tandlianwala", "Faisalabad", "Punjab", "Lahore High Court"],
  "openingHours": "Mo-Sa 09:00-18:00",
  "priceRange": "$$",
  "sameAs": ["{{ site.social.facebook }}", "{{ site.social.instagram }}", "{{ site.social.linkedin }}"],
  "knowsAbout": ["Civil law", "Property law", "Criminal law", "Family law", "Corporate law", "Pakistan law"],
  "founder": { "@type": "Person", "name": "{{ site.name }}", "jobTitle": "{{ site.title }}" }
}
</script>
{%- endif -%}
{%- if isPost -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ title | dump | safe }},
  "description": {{ description | dump | safe }},
  "image": "{{ site.url }}/assets/img/covers/{{ page.fileSlug }}.svg",
  "datePublished": "{{ page.date | isoDate }}",
  "dateModified": "{{ page.date | isoDate }}",
  "inLanguage": "{{ lang }}",
  "articleSection": {{ category | dump | safe }},
  "author": { "@type": "Person", "name": "{{ site.name }}", "jobTitle": "{{ site.title }}", "url": "{{ site.url }}/about/", "sameAs": ["{{ site.social.facebook }}", "{{ site.social.linkedin }}"] },
  "publisher": { "@type": "Person", "name": "{{ site.name }}", "url": "{{ site.url }}" },
  "mainEntityOfPage": "{{ site.url }}{{ page.url }}"
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}{{ '/' if lang == 'en' else '/ur/' }}" },
    { "@type": "ListItem", "position": 2, "name": "Articles", "item": "{{ site.url }}{{ '/blog/' if lang == 'en' else '/ur/blog/' }}" },
    { "@type": "ListItem", "position": 3, "name": {{ title | dump | safe }}, "item": "{{ site.url }}{{ page.url }}" }
  ]
}
</script>
{%- if faq -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for f in faq %}
    { "@type": "Question", "name": {{ f.q | dump | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ f.a | dump | safe }} } }{{ "," if not loop.last }}
    {%- endfor %}
  ]
}
</script>
{%- endif -%}
{%- endif -%}
