---
layout: base.njk
---
{%- set s = t[lang] -%}
{%- set p = "" if lang == "en" else "/ur" -%}
<section class="page-head article-head">
  <div class="container">
    <div class="crumbs"><a href="{{ p }}/">{{ s.nav.home }}</a><span>/</span><a href="{{ p }}/blog/">{{ s.blog.heading }}</a><span>/</span>{{ category }}</div>
    <h1>{{ title }}</h1>
    <p><time datetime="{{ page.date | isoDate }}">{{ page.date | dateDisplay(lang) }}</time> · {{ content | readingTime }} {{ s.blog.minRead }} · {{ site.name if lang == "en" else site.nameUr }}</p>
  </div>
</section>
<section class="article-body section">
  <div class="container two-col">
    <article class="prose">
      <img class="post-cover" src="/assets/img/covers/{{ page.fileSlug }}.svg?v={{ build.v }}" alt="{{ title }}" loading="lazy" onerror="this.remove()">
      {{ content | safe }}
      {% if faq %}
      <section class="faq-block">
        <h2>{{ s.blog.faqHeading }}</h2>
        {% for f in faq %}
        <details class="faq-item" {{ "open" if loop.first }}>
          <summary>{{ f.q }}</summary>
          <p>{{ f.a }}</p>
        </details>
        {% endfor %}
      </section>
      {% endif %}
      <div class="article-disclaimer">{{ s.blog.disclaimer }}</div>
      <div class="author-box">
        <div class="avatar">MF</div>
        <p><strong>{{ site.name if lang == "en" else site.nameUr }}</strong>{{ site.title if lang == "en" else site.titleUr }} · {{ site.address.line2 if lang == "en" else site.address.line2Ur }}</p>
      </div>
    </article>
    <aside class="side">
      <div class="side-box side-cta">
        <h3>{{ s.practice.ctaHeading }}</h3>
        <p>{{ s.home.contactSub }}</p>
        <a class="btn btn-wa" href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener">{% include "icons/whatsapp.svg" %} {{ s.cta.whatsapp }}</a>
        <a class="btn btn-gold" href="tel:{{ site.phoneRaw }}">{{ s.cta.call }}</a>
      </div>
      <div class="side-box">
        <h4>{{ s.nav.practice }}</h4>
        <ul>{% for o in practice %}<li><a href="{{ p }}/practice/{{ o.slug }}/">{{ o[lang].title }}</a></li>{% endfor %}</ul>
      </div>
      <p><a href="{{ p }}/blog/">← {{ s.cta.backToBlog }}</a></p>
    </aside>
  </div>
  {%- set pool = collections.postsEn if lang == "en" else collections.postsUr -%}
  {%- set related = pool | related(page.url, category, 3) -%}
  {% if related.length %}
  <div class="container related-wrap">
    <h2 class="related-heading">{{ s.blog.relatedHeading }}</h2>
    <div class="post-list related-list">
      {% for rp in related %}
      <article class="post-card">
        <a class="post-thumb" href="{{ rp.url }}" tabindex="-1" aria-hidden="true"><img src="/assets/img/covers/{{ rp.fileSlug }}.svg?v={{ build.v }}" alt="" loading="lazy" onerror="this.parentNode.remove()"></a>
        <h3 class="related-title"><a href="{{ rp.url }}">{{ rp.data.title }}</a></h3>
      </article>
      {% endfor %}
    </div>
  </div>
  {% endif %}
</section>
