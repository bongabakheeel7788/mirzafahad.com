{%- set s = t[lang] -%}
{%- set p = "" if lang == "en" else "/ur" -%}
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <div class="brand brand-footer">
        <span class="brand-mark">{% include "icons/gavel.svg" %}</span>
        <span class="brand-text"><strong>{{ site.name if lang == "en" else site.nameUr }}</strong><small>{{ site.title if lang == "en" else site.titleUr }}</small></span>
      </div>
      <p class="footer-address">
        {{ site.address.line1 if lang == "en" else site.address.line1Ur }}<br>
        {{ site.address.line2 if lang == "en" else site.address.line2Ur }}
      </p>
      <p class="footer-contact">
        <a href="tel:{{ site.phoneRaw }}">{{ site.phone }}</a><br>
        <a href="mailto:{{ site.email }}">{{ site.email }}</a>
      </p>
      <div class="socials">
        {% if site.social.facebook %}<a href="{{ site.social.facebook }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.3-1.5 1.6-1.5h1.6V3.6c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.4H7.8V13h2.7v8h3z"/></svg></a>{% endif %}
        {% if site.social.instagram %}<a href="{{ site.social.instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor" stroke="none"/></svg></a>{% endif %}
        {% if site.social.linkedin %}<a href="{{ site.social.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M6.5 8.8H3.6V21h2.9V8.8zM5 7.4a1.7 1.7 0 1 0 0-3.4 1.7 1.7 0 0 0 0 3.4zM21 13.9c0-3.2-1.7-4.7-4-4.7-1.8 0-2.7 1-3.1 1.7V8.8H11V21h2.9v-6.5c0-1.6.8-2.5 2.1-2.5 1.2 0 1.9.8 1.9 2.5V21H21v-7.1z"/></svg></a>{% endif %}
      </div>
    </div>
    <div>
      <h4>{{ s.nav.practice }}</h4>
      <ul>
        {% for a in practice %}<li><a href="{{ p }}/practice/{{ a.slug }}/">{{ a[lang].title }}</a></li>{% endfor %}
      </ul>
    </div>
    <div>
      <h4>{{ s.nav.home }}</h4>
      <ul>
        <li><a href="{{ p }}/about/">{{ s.nav.about }}</a></li>
        <li><a href="{{ p }}/blog/">{{ s.nav.blog }}</a></li>
        <li><a href="{{ p }}/contact/">{{ s.nav.contact }}</a></li>
        <li><a href="{{ collections.all | altUrl(key, lang) }}">{{ s.switchLabel }}</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <p class="disclaimer">{{ s.footer.disclaimer }}</p>
    <p class="copyright">© {{ "" | year }} {{ site.name if lang == "en" else site.nameUr }}. {{ s.footer.rights }}</p>
  </div>
</footer>
