{%- set s = t[lang] -%}
{%- set p = "" if lang == "en" else "/ur" -%}
{%- set posts = collections.postsEn if lang == "en" else collections.postsUr -%}
{%- set world = {
  "town":   { "clip": "/assets/vid/film-town.mp4",    "still": "/assets/img/scroll/town.png" },
  "chamber":{ "clip": "/assets/vid/film-chamber.mp4", "still": "/assets/img/scroll/chamber.png" },
  "conn":   "/assets/vid/film-conn1.mp4"
} -%}
<div id="world" class="film-world" dir="ltr"></div>
<script src="/assets/js/scrub-engine.js?v={{ build.v }}"></script>
<script>
mountLetsScroll(document.getElementById('world'), {
  nav: false,
  atmosphere: true,
  hint: {{ ('"scroll to fly in"' if lang == 'en' else '"نیچے سکرول کریں"') | safe }},
  diveScroll: 1.5,
  connScroll: 0.9,
  sections: [
    {
      id: 'tandlianwala', label: {{ ('"Tandlianwala"' if lang == 'en' else '"ٹانڈلیانوالہ"') | safe }},
      still: '{{ world.town.still }}?v={{ build.v }}',
      clip: '{{ world.town.clip }}?v={{ build.v }}',
      accent: '#c9a227', scroll: 1.7, linger: 0.4,
      eyebrow: {{ (s.home.eyebrow | dump) | safe }},
      title: {{ ('"Every case has a home ground."' if lang == 'en' else '"ہر مقدمے کا اپنا میدان ہوتا ہے۔"') | safe }},
      body: {{ ('"From the tehsil courts of Tandlianwala to the Lahore High Court — every hearing attended personally."' if lang == 'en' else '"ٹانڈلیانوالہ کی تحصیل عدالتوں سے لاہور ہائی کورٹ تک — ہر سماعت پر ذاتی حاضری۔"') | safe }},
      tags: {{ ('["Chamber No. 95","District Courts 2024","High Court 2026"]' if lang == 'en' else '["چیمبر نمبر 95","ضلعی عدالتیں 2024","ہائی کورٹ 2026"]') | safe }}
    },
    {
      id: 'chamber', label: {{ ('"Chamber No. 95"' if lang == 'en' else '"چیمبر نمبر 95"') | safe }},
      still: '{{ world.chamber.still }}?v={{ build.v }}',
      clip: '{{ world.chamber.clip }}?v={{ build.v }}',
      accent: '#e8c96a', scroll: 1.8, linger: 0.5,
      eyebrow: {{ ('"MIRZA FAHAD · ADVOCATE HIGH COURT"' if lang == 'en' else '"مرزا فہد · ایڈووکیٹ ہائی کورٹ"') | safe }},
      title: {{ ('"Sit down with your advocate."' if lang == 'en' else '"اپنے وکیل کے ساتھ بیٹھیے۔"') | safe }},
      body: {{ ('"An honest first assessment — strengths, risks, time and cost — before you commit to anything."' if lang == 'en' else '"کسی فیصلے سے پہلے دیانت دارانہ ابتدائی جائزہ — مضبوطی، خطرات، وقت اور خرچ۔"') | safe }},
      tags: [],
      cta: {
        primary: { label: {{ (s.cta.consult | dump) | safe }}, href: '{{ p }}/contact/' },
        secondary: { label: {{ (s.cta.whatsapp | dump) | safe }}, href: 'https://wa.me/{{ site.whatsapp }}' }
      }
    }
  ],
  connectors: ['{{ world.conn }}?v={{ build.v }}']
});
</script>
<div class="after-film">

<section class="stats reveal">
  <div class="container stats-inner">
    {% for st in s.home.stats %}
    <div class="stat">
      <div class="stat-num"><span data-count="{{ st.num }}">0</span><sup>{{ st.suffix }}</sup></div>
      <div class="stat-label">{{ st.label }}</div>
    </div>
    {% endfor %}
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <h4>{{ s.nav.practice }}</h4>
      <h2>{{ s.home.practiceHeading }}</h2>
      <p>{{ s.home.practiceSub }}</p>
    </div>
    <div class="grid grid-4">
      {% for a in practice %}
      <a class="card reveal" style="--d:{{ loop.index0 * 0.12 }}s" href="{{ p }}/practice/{{ a.slug }}/">
        <span class="card-num">0{{ loop.index }}</span>
        <div class="card-icon">{% include "icons/" + a.icon + ".svg" %}</div>
        <h3>{{ a[lang].title }}</h3>
        <p>{{ a[lang].short }}</p>
        <span class="more">{{ s.cta.learnMore }}</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section" style="padding-top:0">
  <div class="container">
    <div class="section-head reveal">
      <h4>{{ s.about.approachHeading }}</h4>
      <h2>{{ s.home.whyHeading }}</h2>
      <p>{{ s.home.whySub }}</p>
    </div>
    <div class="process">
      {% for w in s.home.why %}
      <div class="process-item reveal" style="--d:{{ loop.index0 * 0.15 }}s">
        <div class="process-dot">{{ loop.index }}</div>
        <h3>{{ w.h }}</h3>
        <p>{{ w.p }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{% if posts.length %}
<section class="section" style="padding-top:0">
  <div class="container">
    <div class="section-head reveal">
      <h4>{{ s.nav.blog }}</h4>
      <h2>{{ s.home.articlesHeading }}</h2>
      <p>{{ s.home.articlesSub }}</p>
    </div>
    <div class="post-list">
      {% for post in posts | head(2) %}
      <article class="post-card reveal" style="--d:{{ loop.index0 * 0.12 }}s">
        <a class="post-thumb" href="{{ post.url }}" tabindex="-1" aria-hidden="true"><img src="/assets/img/covers/{{ post.fileSlug }}.svg?v={{ build.v }}" alt="" loading="lazy" onerror="this.parentNode.remove()"></a>
        <div class="post-meta"><span class="tag">{{ post.data.category }}</span><time datetime="{{ post.date | isoDate }}">{{ post.date | dateDisplay(lang) }}</time></div>
        <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
        <p>{{ post.data.description }}</p>
        <a class="more" href="{{ post.url }}">{{ s.cta.readMore }}</a>
      </article>
      {% endfor %}
    </div>
    <p style="margin-top:2.2rem" class="reveal"><a class="btn btn-ghost" href="{{ p }}/blog/">{{ s.cta.viewAll }}</a></p>
  </div>
</section>
{% endif %}

<section class="cta-band">
  <div class="container reveal">
    <h2>{{ s.home.contactHeading }}</h2>
    <p>{{ s.home.contactSub }}</p>
    <div class="hero-actions">
      <a class="btn btn-wa" data-magnetic href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener">{% include "icons/whatsapp.svg" %} {{ s.cta.whatsapp }}</a>
      <a class="btn btn-gold" data-magnetic href="tel:{{ site.phoneRaw }}">{{ site.phone }}</a>
      <a class="btn btn-ghost" href="{{ p }}/contact/">{{ s.nav.contact }}</a>
    </div>
  </div>
</section>
</div><!-- /after-film -->
